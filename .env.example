# Copy to .env and fill in. Never commit .env.
# REQUIRED. Use a long random throwaway value, used nowhere else (the demo is plain HTTP).
ACCESS_KEY=change-me-to-a-long-random-value
# Keep 3000: docker-compose.yml and the image health check use this port.
PORT=3000
# Request body limit in KB (assumption: 1024)
MAX_BODY_KB=1024
# Stop reporting after this many findings (assumption: 1000)
MAX_FINDINGS=1000
# Minimum hours between shifts (assumption: 11)
MIN_REST_HOURS=11
