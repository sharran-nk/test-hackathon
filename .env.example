# Copy to .env and fill in. Never commit .env.
# REQUIRED. Signs login tokens (JWT). At least 32 random characters, used nowhere else.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-value-of-32-or-more-chars
# How long a login lasts (for example 30m, 8h, 1d)
JWT_EXPIRES_IN=8h
# Keep 3000: docker-compose.yml and the image health check use this port.
PORT=3000
# Request body limit in KB (assumption: 1024)
MAX_BODY_KB=1024
# Stop reporting after this many findings (assumption: 1000)
MAX_FINDINGS=1000
# Minimum hours between shifts (assumption: 11)
MIN_REST_HOURS=11

# MongoDB (REQUIRED for docker compose). The app builds its connection URI from these and
# URL-encodes them, so special characters in the password are fine. The mongo container takes
# them only the FIRST time its volume is created: changing them later does not change the
# existing database user (see docs/DEPLOY.md).
MONGO_ROOT_USERNAME=rosteradmin
MONGO_ROOT_PASSWORD=change-me-to-a-long-random-value
# Local development outside Docker only (compose ignores it): a full URI overrides the parts above
# MONGODB_URI=mongodb://localhost:27017/roster
# Host port for the app. Keep 3000 unless something else on the host already uses it.
# APP_PORT=3000
# Demo manager password. Hashed with bcrypt on first seed only; never overwritten on restart.
MANAGER_PASSWORD=manager123
# Days before saved rosters, results and findings expire
RETENTION_DAYS=30
