{
  "name": "roster-checker",
  "version": "1.0.0",
  "private": true,
  "description": "Checks a roster for double-bookings before it is published",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ]
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.0.0"
  }
}
